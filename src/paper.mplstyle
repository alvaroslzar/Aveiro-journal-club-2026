text.usetex:         True
text.latex.preamble: \usepackage{amsmath}\usepackage{amssymb}

font.family: serif
font.serif:  Computer Modern

# axes.titlesize: medium

# figure.titlesize: medium
# figure.labelsize: medium

# Set everything explicitly to match your paper's font size (10 pt)
axes.titlesize: 10
axes.labelsize: 10
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10

figure.titlesize: 10

xtick.direction: in
ytick.direction: in

savefig.bbox:   tight
savefig.format: pdf